@startuml
title Авторизация с обработкой ошибок — Activity Diagram

skinparam backgroundColor #FEFEFE

|#E3F2FD|Frontend|
|#E8F5E9|Backend|
|#FFF3E0|Database|
|#F3E5F5|Email Service|

|Frontend|
start
:Показать форму логина;
:Ввести логин и пароль;

:POST /api/auth/login;

|Backend|
:Валидировать формат JSON;

if (Формат валиден?) then (да)
  
  :Проверить rate limit (Redis);
  
  if (Не превышен?) then (да)
    
    :SELECT пользователя по email;
    
    |Database|
    :Выполнить запрос;
    
    if (Таймаут БД?) then (нет)
      
      :Вернуть user или NULL;
      
      |Backend|
      if (Пользователь найден?) then (да)
        
        :Проверить failed_login_count;
        
        if (Аккаунт заблокирован?) then (нет)
          
          :Проверить hash(password);
          
          if (Пароль верный?) then (да)
            
            :Сбросить failed_login_count;
            :Генерировать JWT токен;
            
            |Database|
            :INSERT session;
            :Подтвердить;
            
            |Backend|
            :Отправить email
            {login_success}
            **<<send signal>>**;
            
            |Email Service|
            :Принять сигнал
            {login_success}
            **<<accept event>>**;
            
            :Отправить email;
            
            if (Успешно?) then (да)
              :Логировать доставку;
            else (нет)
              :Таймаут 5min;
              :Повторная отправка;
            endif
            
            |Backend|
            :Вернуть {token, user};
            
            |Frontend|
            :Сохранить токен;
            :Перейти в профиль;
            
            stop
            
          else (нет)
            
            |Backend|
            :Increment failed_login_count;
            :UPDATE users;
            
            if (failed_count >= 3?) then (да)
              :Блокировать аккаунт;
              :Вернуть 423 Locked;
              
              |Frontend|
              :Показать ошибку
              "Аккаунт заблокирован";
              
              end
              
            else (нет)
              :Вернуть 401 Unauthorized;
              
              |Frontend|
              :Показать ошибку
              "Неверные данные";
              
              end
            endif
            
          endif
          
        else (да)
          
          |Backend|
          :Вернуть 423 Locked;
          
          |Frontend|
          :Показать ошибку
          "Аккаунт заблокирован";
          
          end
          
        endif
        
      else (нет)
        
        |Backend|
        :Вернуть 404 Not Found;
        
        |Frontend|
        :Показать ошибку
        "Пользователь не найден";
        
        end
        
      endif
      
    else (да)
      
      |Database|
      :Вернуть таймаут;
      
      |Backend|
      :Вернуть 504 Gateway Timeout;
      
      |Frontend|
      :Показать ошибку
      "Сервис недоступен";
      
      end
      
    endif
    
  else (нет)
    
    |Backend|
    :Вернуть 429 Too Many Requests;
    
    |Frontend|
    :Показать ошибку
    "Слишком много попыток";
    
    end
    
  endif
  
else (нет)
  
  |Backend|
  :Вернуть 400 Bad Request;
  
  |Frontend|
  :Показать ошибку
  "Неверный формат данных";
  
  end
  
endif

@enduml