@startuml
skinparam sequenceMessageAlign center

title Password Reset — Sequence Diagram

actor ":User" as U
participant ":WebApp" as W
participant ":AuthService" as AS
participant ":EmailService" as ES

== Request Submission ==
U -> W : clickForgotPassword(email)
activate W
W -> AS : requestPasswordReset(email)
activate AS

== Email Validation ==
AS -> AS : checkEmailExists()

== Secure Response (Same Message Both Paths) ==
alt email exists
    AS -> AS : generateToken()
    AS ->> ES : sendResetEmail(token)
    activate ES
    deactivate ES
    AS --> W : return "Instructions sent"
else else
    AS --> W : return "Instructions sent"
end

deactivate AS
W --> U : display("Instructions sent")
deactivate W

@enduml